# Add your ENTSO-E Transparency Platform token. 
ENTSOE_API_TOKEN=

# ENTSO-E API endpoint and Norwegian bidding-zone EICs.
greenpulse_ENTSOE_API_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_EIC_NO1=10YNO-1--------2
ENTSOE_EIC_NO2=10YNO-2--------T
ENTSOE_EIC_NO3=10YNO-3--------J
ENTSOE_EIC_NO4=10YNO-4--------9
ENTSOE_EIC_NO5=10Y1001A1001A48H

# Bounded upstream request settings.
GREENPULSE_ENTSOE_TIMEOUT_SECONDS=75
GREENPULSE_ENTSOE_RETRIES=2
GREENPULSE_JAO_TIMEOUT_SECONDS=60
GREENPULSE_JAO_RETRIES=2
GREENPULSE_JAO_PAGE_SIZE=50000
GREENPULSE_JAO_MAX_PAGES=24
GREENPULSE_JAO_MIN_REQUEST_INTERVAL_SECONDS=0.70

# API / browser configuration.
greenpulse_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_greenpulse_API_URL=http://127.0.0.1:8000

# Optional native monitor endpoint overrides.
greenpulse_API_BASE_URL=http://127.0.0.1:8000
greenpulse_MARKET_PRICES_URL=http://127.0.0.1:8000/api/market/prices
greenpulse_STATNETT_FLOW_URL=https://driftsdata.statnett.no/restapi/PhysicalFlowMap/GetFlow
greenpulse_STATNETT_FREQUENCY_URL=https://driftsdata.statnett.no/restapi/Frequency/ByMinute
